[Unit]
Description=biosignal-mock STAND-IN (testing only; replace with the official biosignal-mock)
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pipeline
Group=pipeline
Environment=BIOSIGNAL_MOCK_GT_DIR=/var/lib/pipeline-mock-gt
WorkingDirectory=/var/lib/pipeline-mock-gt
ExecStart=/usr/local/bin/biosignal-mock --mode signal --seed 7 --duration 3600 --port 7100
Restart=always
RestartSec=1
StateDirectory=pipeline-mock-gt

[Install]
WantedBy=multi-user.target
